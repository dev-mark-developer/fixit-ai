# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-firebase v26 resolves the Firebase SDK through Swift Package
# Manager by default, and those products are automatic (non-dynamic) libraries
# — with this project's static linkage each RNFB pod embeds its own copy and
# they collide as duplicate symbols at link time.
#
# Opting out puts Firebase back on ordinary CocoaPods, which is compatible with
# static linkage. The alternative RNFB suggests — use_frameworks! :dynamic —
# would change linkage for every other native module in the app (nitro,
# reanimated, vector-icons …), which is a far bigger blast radius.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Fixit' do
  config = use_native_modules!

  # Firebase's Swift pods (FirebaseCoreInternal) import GoogleUtilities, which
  # ships no module map. Under static linking Swift can't import it without
  # one. Scoped to this pod rather than a global `use_modular_headers!`, which
  # would change header generation for every dependency in the project.
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # RN 0.85 ships React Native core as a prebuilt xcframework and swaps the
    # Debug/Release variant at build time from a marker file, via
    # `scripts/replace-rncore-version.js`. A fresh install extracts the
    # *Release* framework, but that script assumes "no marker means Debug" and
    # skips the swap — so a Debug build links Debug-compiled Fabric pods
    # (Screens, GestureHandler, DateTimePicker) against Release core, which has
    # the debug-only symbols compiled out under NDEBUG. It fails at link with
    # `Sealable::Sealable()`, `ShadowNode::getDebugName()` and friends.
    #
    # Seeding the marker with the truth — Release — makes the first Debug build
    # perform the swap. The script maintains the file from then on.
    rncore_dir = File.join(installer.sandbox.root, 'React-Core-prebuilt')
    rncore_marker = File.join(rncore_dir, '.last_build_configuration')
    if Dir.exist?(rncore_dir) && !File.exist?(rncore_marker)
      File.write(rncore_marker, 'Release')
      Pod::UI.puts "[RNCore] Seeded .last_build_configuration=Release so Debug builds swap in the Debug core.".green
    end

    # Xcode 27 refuses to build a target whose minimum iOS is below 15.0; older
    # Xcode only warned. React Native raises each pod's own target to its
    # minimum, but not the resource bundles CocoaPods creates beside them —
    # Firebase's *_Privacy bundles (9.0 / 12.0) and AsyncStorage's (13.4) kept
    # their podspec's number and failed the build. Anything below React
    # Native's minimum is raised to it; higher targets are left alone.
    min_ios = Gem::Version.new(min_ios_version_supported)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next if current.nil? || Gem::Version.new(current) >= min_ios
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
      end
    end
  end
end
